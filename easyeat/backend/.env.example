# ==============================================================================
# EasyEat Backend - Environment Variables Template
# ==============================================================================
# Copy this file to .env (or export these variables in your shell) to override
# defaults in application-dev.yml. Do NOT commit your real .env file with secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Defaults match docker-compose.yml)
# ------------------------------------------------------------------------------
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/easyeat
# SPRING_DATASOURCE_USERNAME=easyeat
# SPRING_DATASOURCE_PASSWORD=easyeat_dev_password

# ------------------------------------------------------------------------------
# 2. JWT Security
# ------------------------------------------------------------------------------
# JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 3. SMTP Mail Configuration (Agnostic - Mailpit vs Real Relays)
# ------------------------------------------------------------------------------

# --- Profile A: Local Mock Relay (Mailpit via Docker - DEFAULT) ---
# If all SPRING_MAIL_* variables are omitted, application-dev.yml defaults to:
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
APP_MAIL_FROM=noreply@easyeat.com

# --- Profile B: Real Relay via Gmail (Example) ---
# Requires 2-Step Verification and an App Password (16 characters, no spaces):
# Generate at: https://myaccount.google.com/apppasswords
# Note: Google overrides the sender to match the authenticated username.
#
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=tu_cuenta@gmail.com
# SPRING_MAIL_PASSWORD=tu_app_password_16_letras
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# APP_MAIL_FROM=tu_cuenta@gmail.com

# --- Profile C: Dedicated Transactional Service (e.g., SendGrid, Brevo, Resend) ---
# SPRING_MAIL_HOST=smtp.sendgrid.net
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=apikey
# SPRING_MAIL_PASSWORD=your_api_key_here
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# APP_MAIL_FROM=soporte@easyeat.com

# ------------------------------------------------------------------------------
# 4. Frontend Password Reset Base URL
# ------------------------------------------------------------------------------
# APP_PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password
