# ==============================================================================
# EasyEat Backend - Plantilla de Variables de Entorno
# ==============================================================================
# Copiar este archivo a .env en easyeat/backend/ para sobrescribir la configuracion.
# No commitear el archivo .env real con credenciales productivas.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL)
# ------------------------------------------------------------------------------
# Conexion JDBC a PostgreSQL. Los valores por defecto coinciden con docker-compose.yml.
# En produccion, reemplazar por la URL, usuario y contrasena de la base gestionada.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/easyeat
SPRING_DATASOURCE_USERNAME=easyeat
SPRING_DATASOURCE_PASSWORD=easyeat_dev_password

# ------------------------------------------------------------------------------
# 2. Seguridad y Autenticacion (JWT)
# ------------------------------------------------------------------------------
# Clave criptografica para firmar y validar tokens JWT (minimo 256 bits).
# En produccion, generar un secreto aleatorio unico de alta entropia.
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 3. Servicio de Email (SMTP)
# ------------------------------------------------------------------------------
# Configuracion del servidor de correo saliente para activaciones y recuperacion.
# - Local (Mailpit en Docker): host=localhost, port=1025, auth=false, starttls=false.
# - Gmail Relay: host=smtp.gmail.com, port=587, auth=true, starttls=true, password=app_password_16_caracteres.
# - Transaccional (SendGrid/Brevo/Resend): host del proveedor, port=587, auth=true, username=apikey, password=api_key.
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
APP_MAIL_FROM=noreply@easyeat.com

# ------------------------------------------------------------------------------
# 4. URLs de Accion del Frontend (Enlaces en Emails)
# ------------------------------------------------------------------------------
# Direcciones que el backend inserta en los enlaces de restablecimiento y activacion.
# En produccion, reemplazar http://localhost:3000 por el dominio publico del frontend.
APP_PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password
APP_EMAIL_VERIFICATION_BASE_URL=http://localhost:3000/verificar-email

# ------------------------------------------------------------------------------
# 5. Origenes Permitidos para CORS
# ------------------------------------------------------------------------------
# Lista separada por comas de dominios autorizados para consultar la API via navegador.
# En produccion, agregar la URL publica del frontend (ej: https://app.easyeat.com).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Mercado Pago Checkout Pro
# ------------------------------------------------------------------------------
# Integracion con la pasarela de pagos.
# - Pruebas: MERCADOPAGO_SANDBOX=true (TEST-...) o MERCADOPAGO_SANDBOX=false con credenciales modernas APP_USR-... de prueba/produccion.
# - MERCADOPAGO_WEBHOOK_SECRET: Obligatoria en entornos con webhooks firmados (x-signature). Si falta o esta vacia, el endpoint responde 401 fail-closed.
# - MERCADOPAGO_FRONTEND_BASE_URL: URL publica del frontend a donde Mercado Pago redirige al comensal tras pagar.
# - MERCADOPAGO_BACKEND_BASE_URL: URL publica HTTPS del backend usada para construir notification_url del webhook. En local puede quedar vacia (se omite notification_url); en Render usa RENDER_EXTERNAL_URL como respaldo automatico.
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_ACCESS_TOKEN=TEST-1234567890123456-110902-abcdef1234567890abcdef1234567890-123456789
MERCADOPAGO_PUBLIC_KEY=TEST-12345678-abcd-1234-ef01-1234567890ab
MERCADOPAGO_WEBHOOK_SECRET=test_whsec_1234567890abcdef1234567890abcdef
MERCADOPAGO_FRONTEND_BASE_URL=http://localhost:3000
MERCADOPAGO_BACKEND_BASE_URL=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com

# ------------------------------------------------------------------------------
# 7. Servidor y Perfil de Ejecucion
# ------------------------------------------------------------------------------
# Perfil activo de Spring Boot (dev, local, prod) y puerto HTTP local del backend.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
